# Copy these into your host's environment variables.
NODE_ENV=production
# Random string, at least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# First admin login (created on first start only)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Folder on a persistent disk for the database and photos
DATA_DIR=/data
