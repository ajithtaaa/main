[
 {
  "scene": "hook",
  "text": "ഒരു സ്ത്രീ ഒരു പുരുഷനെ ഭ്രാന്തമായി ആഗ്രഹിക്കാൻ തുടങ്ങുന്നത് എപ്പോഴാണെന്ന് അറിയാമോ?",
  "start": 0.13,
  "end": 4.852
 },
 {
  "scene": "hook",
  "text": "അവൻ സുന്ദരനായതുകൊണ്ടല്ല.",
  "start": 5.918,
  "end": 7.486
 },
 {
  "scene": "hook",
  "text": "പണമുള്ളതുകൊണ്ടുമല്ല.",
  "start": 7.986,
  "end": 8.923
 },
 {
  "scene": "tease",
  "text": "ഈ വീഡിയോയുടെ അവസാനം ഞാൻ ഒരു രഹസ്യം പറയാൻ പോകുന്നു.",
  "start": 9.425,
  "end": 12.054
 },
 {
  "scene": "tease",
  "text": "അത് അറിഞ്ഞാൽ, ഒരു സ്ത്രീയെ നീ നോക്കുന്ന രീതി തന്നെ മാറും.",
  "start": 12.447,
  "end": 15.406
 },
 {
  "scene": "tease",
  "text": "അതുകൊണ്ട് സ്കിപ്പ് ചെയ്യരുത്!",
  "start": 15.752,
  "end": 17.015
 },
 {
  "scene": "arjun",
  "text": "ആദ്യം ഒരു കഥ പറയാം.",
  "start": 17.608,
  "end": 18.836
 },
 {
  "scene": "arjun",
  "text": "അർജുൻ.",
  "start": 19.346,
  "end": 19.669
 },
 {
  "scene": "arjun",
  "text": "ഇരുപത്തിയാറ് വയസ്സ്.",
  "start": 20.082,
  "end": 20.914
 },
 {
  "scene": "arjun",
  "text": "അവന് ഒരു പെൺകുട്ടിയെ ഭയങ്കര ഇഷ്ടമായിരുന്നു.",
  "start": 21.359,
  "end": 23.83
 },
 {
  "scene": "arjun",
  "text": "അവൾ എന്ത് ചോദിച്ചാലും ചെയ്തുകൊടുക്കും.",
  "start": 24.271,
  "end": 25.892
 },
 {
  "scene": "arjun",
  "text": "രാത്രി രണ്ട് മണി വരെ ചാറ്റ് ചെയ്യും.",
  "start": 26.21,
  "end": 27.918
 },
 {
  "scene": "arjun",
  "text": "ഓരോ മെസ്സേജിനും ഉടൻ മറുപടി.",
  "start": 28.252,
  "end": 29.98
 },
 {
  "scene": "reject",
  "text": "എന്നിട്ടും ഒരു ദിവസം അവൾ പറഞ്ഞു.",
  "start": 30.613,
  "end": 33.239
 },
 {
  "scene": "reject",
  "text": "\"നീ നല്ലവനാണ്... പക്ഷേ എനിക്ക് അങ്ങനെയൊരു ഫീലിംഗ് ഇല്ല.\"",
  "start": 33.748,
  "end": 37.353
 },
 {
  "scene": "reject",
  "text": "അർജുന് എന്താണ് തെറ്റിയത്?",
  "start": 37.946,
  "end": 39.536
 },
 {
  "scene": "reject",
  "text": "അതിന് ശേഷം അവൻ എന്ത് മാറ്റി?",
  "start": 40.0,
  "end": 41.629
 },
 {
  "scene": "reject",
  "text": "അതും ഈ വീഡിയോയിൽ തന്നെ പറയാം.",
  "start": 42.069,
  "end": 43.616
 },
 {
  "scene": "mistake",
  "text": "അർജുൻ ചെയ്ത തെറ്റ്, നമ്മളിൽ മിക്കവരും ചെയ്യുന്ന തെറ്റാണ്.",
  "start": 44.161,
  "end": 47.251
 },
 {
  "scene": "mistake",
  "text": "അവളെ നമ്മുടെ ജീവിതത്തിന്റെ കേന്ദ്രമാക്കുന്നത്.",
  "start": 47.758,
  "end": 50.273
 },
 {
  "scene": "mistake",
  "text": "നീ നിന്റെ ലോകം മുഴുവൻ അവൾക്കുവേണ്ടി മാറ്റിവെക്കുമ്പോൾ,",
  "start": 50.745,
  "end": 53.626
 },
 {
  "scene": "mistake",
  "text": "അവൾക്ക് നിന്നിൽ കണ്ടെത്താൻ ഒന്നും ബാക്കിയില്ലാതാകും.",
  "start": 53.918,
  "end": 56.444
 },
 {
  "scene": "mistake",
  "text": "അട്രാക്ഷന് ഒരു ചെറിയ മിസ്റ്ററി വേണം.",
  "start": 56.889,
  "end": 59.061
 },
 {
  "scene": "mistake",
  "text": "ഒരു ആഴം വേണം.",
  "start": 59.506,
  "end": 60.62
 },
 {
  "scene": "six",
  "text": "ഇനി നമുക്ക് ശരിക്കും വർക്ക് ചെയ്യുന്ന ആറ് കാര്യങ്ങൾ നോക്കാം.",
  "start": 61.107,
  "end": 64.032
 },
 {
  "scene": "six",
  "text": "നാലാമത്തെ പോയിന്റ് മിക്ക ആണുങ്ങൾക്കും അറിയില്ല.",
  "start": 64.441,
  "end": 66.872
 },
 {
  "scene": "p1",
  "text": "ഒന്ന്.",
  "start": 67.393,
  "end": 67.652
 },
 {
  "scene": "p1",
  "text": "നിനക്ക് സ്വന്തമായി ഒരു മിഷൻ വേണം.",
  "start": 68.133,
  "end": 70.132
 },
 {
  "scene": "p1",
  "text": "ജിം, കരിയർ, ബിസിനസ്, മ്യൂസിക്, എന്തുമാകട്ടെ.",
  "start": 70.539,
  "end": 73.846
 },
 {
  "scene": "p1",
  "text": "ഒരു ലക്ഷ്യത്തിനുവേണ്ടി ജീവിക്കുന്ന പുരുഷന്റെ കണ്ണുകളിൽ ഒരു തീയുണ്ട്.",
  "start": 74.247,
  "end": 77.55
 },
 {
  "scene": "p1",
  "text": "അവൾ അത് ശ്രദ്ധിക്കും.",
  "start": 77.914,
  "end": 78.89
 },
 {
  "scene": "p1",
  "text": "നിന്റെ ലോകത്തിലേക്ക് കടക്കാൻ അവൾ ആഗ്രഹിക്കും.",
  "start": 79.305,
  "end": 81.637
 },
 {
  "scene": "p1",
  "text": "കാരണം, നീ അവളുടെ പിന്നാലെ ഓടുന്നില്ല.",
  "start": 82.007,
  "end": 84.247
 },
 {
  "scene": "p1",
  "text": "നീ എവിടേക്കോ മുന്നോട്ട് ഓടുകയാണ്.",
  "start": 84.601,
  "end": 86.404
 },
 {
  "scene": "p2",
  "text": "രണ്ട്.",
  "start": 86.959,
  "end": 87.285
 },
 {
  "scene": "p2",
  "text": "അവൾ പറയുന്നത് ശരിക്കും കേൾക്കുക.",
  "start": 87.701,
  "end": 89.595
 },
 {
  "scene": "p2",
  "text": "മിക്ക ആണുങ്ങളും കേൾക്കുന്നത് മറുപടി പറയാനാണ്.",
  "start": 89.996,
  "end": 92.678
 },
 {
  "scene": "p2",
  "text": "മനസ്സിലാക്കാനല്ല.",
  "start": 92.988,
  "end": 93.856
 },
 {
  "scene": "p2",
  "text": "അവൾ മൂന്ന് ദിവസം മുൻപ് പറഞ്ഞ ഒരു ചെറിയ കാര്യം ഓർത്തുവെച്ച് ചോദിച്ചുനോക്കൂ.",
  "start": 94.26,
  "end": 98.147
 },
 {
  "scene": "p2",
  "text": "\"അമ്മയുടെ ഡോക്ടർ അപ്പോയിന്റ്മെന്റ് എന്തായി?\"",
  "start": 98.528,
  "end": 100.213
 },
 {
  "scene": "p2",
  "text": "അവളുടെ മുഖത്ത് ഒരു മാറ്റം കാണാം.",
  "start": 100.629,
  "end": 102.393
 },
 {
  "scene": "p2",
  "text": "കാരണം, ഇന്നത്തെ ലോകത്ത് ആരും ശരിക്കും ശ്രദ്ധിക്കുന്നില്ല.",
  "start": 102.772,
  "end": 106.143
 },
 {
  "scene": "p2",
  "text": "നീ ശ്രദ്ധിക്കുമ്പോൾ, നീ വ്യത്യസ്തനാകും.",
  "start": 106.544,
  "end": 108.709
 },
 {
  "scene": "p3",
  "text": "മൂന്ന്.",
  "start": 109.361,
  "end": 109.665
 },
 {
  "scene": "p3",
  "text": "പുതിയ അനുഭവങ്ങൾ ഒരുമിച്ച് ഉണ്ടാക്കുക.",
  "start": 110.108,
  "end": 112.012
 },
 {
  "scene": "p3",
  "text": "സൈക്കോളജിസ്റ്റുകൾ നടത്തിയ പഠനങ്ങളിൽ ഒരു കാര്യം കണ്ടെത്തി.",
  "start": 112.436,
  "end": 115.288
 },
 {
  "scene": "p3",
  "text": "പുതിയതും ആവേശകരവുമായ കാര്യങ്ങൾ ഒരുമിച്ച് ചെയ്യുന്നവർക്കിടയിൽ അടുപ്പം വേഗത്തിൽ കൂടുന്നു.",
  "start": 115.67,
  "end": 117.753
 },
 {
  "scene": "p3",
  "text": "ഒരേ കഫേ, ഒരേ സിനിമ, ഒരേ ചാറ്റ്.",
  "start": 117.905,
  "end": 119.148
 },
 {
  "scene": "p3",
  "text": "ഇത് ബോറാണ്.",
  "start": 119.349,
  "end": 119.787
 },
 {
  "scene": "p3",
  "text": "പകരം ഒരു സൺറൈസ് ട്രെക്ക്.",
  "start": 119.894,
  "end": 120.788
 },
 {
  "scene": "p3",
  "text": "ഒരു പുതിയ ഫുഡ് സ്ട്രീറ്റ്.",
  "start": 121.161,
  "end": 121.877
 },
 {
  "scene": "p3",
  "text": "ഒരു മഴയത്തുള്ള ബൈക്ക് യാത്ര.",
  "start": 122.093,
  "end": 122.829
 },
 {
  "scene": "p3",
  "text": "ആ ത്രില്ലിന്റെ ഓർമ്മകൾ അവളുടെ മനസ്സിൽ നിന്റെ മുഖവുമായി ചേർന്നിരിക്കും.",
  "start": 123.032,
  "end": 124.811
 },
 {
  "scene": "comment",
  "text": "ഇതുവരെ പറഞ്ഞതിൽ ഏതാണ് നീ ഇതുവരെ ചെയ്യാത്തത്?",
  "start": 125.227,
  "end": 126.808
 },
 {
  "scene": "comment",
  "text": "കമന്റിൽ നമ്പർ മാത്രം ഇട്ടാൽ മതി.",
  "start": 127.163,
  "end": 128.278
 },
 {
  "scene": "comment",
  "text": "ഇനി ഞാൻ പറഞ്ഞ ആ നാലാമത്തെ പോയിന്റ്.",
  "start": 128.622,
  "end": 130.317
 },
 {
  "scene": "p4",
  "text": "നാല്.",
  "start": 130.681,
  "end": 130.851
 },
 {
  "scene": "p4",
  "text": "ഇമോഷണൽ സേഫ്റ്റി.",
  "start": 130.954,
  "end": 131.899
 },
 {
  "scene": "p4",
  "text": "ഇന്റർനെറ്റിൽ പലരും പറയും,",
  "start": 132.111,
  "end": 133.543
 },
 {
  "scene": "p4",
  "text": "അവളെ അവഗണിക്കൂ, ജെലസി ഉണ്ടാക്കൂ, ഗെയിം കളിക്കൂ എന്നൊക്കെ.",
  "start": 133.721,
  "end": 136.67
 },
 {
  "scene": "p4",
  "text": "ഇത് കുറച്ചുകാലം വർക്ക് ചെയ്തേക്കാം.",
  "start": 137.123,
  "end": 138.556
 },
 {
  "scene": "p4",
  "text": "പക്ഷേ അത് ഉണ്ടാക്കുന്നത് ആകാംക്ഷയാണ്, സ്നേഹമല്ല.",
  "start": 138.977,
  "end": 140.338
 },
 {
  "scene": "p4",
  "text": "ശരിയായ വഴി ഇതാണ്.",
  "start": 140.512,
  "end": 141.15
 },
 {
  "scene": "p4",
  "text": "നിന്റെ വാക്കും പ്രവൃത്തിയും ഒന്നായിരിക്കണം.",
  "start": 141.631,
  "end": 142.62
 },
 {
  "scene": "p4",
  "text": "പറഞ്ഞ സമയത്ത് വരിക.",
  "start": 143.07,
  "end": 143.976
 },
 {
  "scene": "p4",
  "text": "ദേഷ്യം വന്നാലും ബഹുമാനത്തോടെ സംസാരിക്കുക.",
  "start": 144.149,
  "end": 145.514
 },
 {
  "scene": "p4",
  "text": "ഒരു സ്ത്രീക്ക് ഒരു പുരുഷന്റെ കൂടെ പൂർണ്ണമായും അവളായിരിക്കാൻ കഴിയുമ്പോൾ,",
  "start": 145.924,
  "end": 150.075
 },
 {
  "scene": "p4",
  "text": "അവൾ ആ സ്ഥലം വിട്ടുപോകാൻ ആഗ്രഹിക്കില്ല.",
  "start": 150.314,
  "end": 152.702
 },
 {
  "scene": "p5",
  "text": "അഞ്ച്.",
  "start": 153.334,
  "end": 153.657
 },
 {
  "scene": "p5",
  "text": "ശാന്തമായ കോൺഫിഡൻസ്.",
  "start": 154.11,
  "end": 155.533
 },
 {
  "scene": "p5",
  "text": "കോൺഫിഡൻസ് എന്നാൽ ഉറക്കെ സംസാരിക്കുന്നതല്ല.",
  "start": 156.005,
  "end": 158.292
 },
 {
  "scene": "p5",
  "text": "\"അറിയില്ല\" എന്ന് പറയാൻ മടിയില്ലാത്തതാണ്.",
  "start": 158.659,
  "end": 160.94
 },
 {
  "scene": "p5",
  "text": "തെറ്റ് പറ്റിയാൽ \"സോറി\" എന്ന് പറയാൻ കഴിയുന്നതാണ്.",
  "start": 161.3,
  "end": 164.003
 },
 {
  "scene": "p5",
  "text": "സ്വന്തം അഭിപ്രായം പറയാൻ, അവൾ സമ്മതിച്ചില്ലെങ്കിലും, ധൈര്യമുള്ളതാണ്.",
  "start": 164.366,
  "end": 168.073
 },
 {
  "scene": "p5",
  "text": "സ്വയം അംഗീകരിക്കുന്ന പുരുഷനെ സ്ത്രീകൾ ആഴത്തിൽ ബഹുമാനിക്കും.",
  "start": 168.437,
  "end": 172.01
 },
 {
  "scene": "p6",
  "text": "ആറ്.",
  "start": 172.639,
  "end": 172.939
 },
 {
  "scene": "p6",
  "text": "അവളുടെ സ്വപ്നങ്ങളുടെ ഏറ്റവും വലിയ ഫാൻ ആവുക.",
  "start": 173.469,
  "end": 176.174
 },
 {
  "scene": "p6",
  "text": "അവൾ ഒരു പുതിയ കാര്യം തുടങ്ങാൻ പറയുമ്പോൾ,",
  "start": 176.583,
  "end": 178.742
 },
 {
  "scene": "p6",
  "text": "\"അത് നടക്കില്ല\" എന്ന് പറയുന്നവരാണ് ചുറ്റും.",
  "start": 179.067,
  "end": 181.175
 },
 {
  "scene": "p6",
  "text": "നീ മാത്രം പറയൂ,",
  "start": 181.549,
  "end": 182.469
 },
 {
  "scene": "p6",
  "text": "\"നിനക്ക് പറ്റും. ഞാനുണ്ട് കൂടെ.\"",
  "start": 182.81,
  "end": 184.589
 },
 {
  "scene": "secret",
  "text": "ഇനി ഞാൻ തുടക്കത്തിൽ പറഞ്ഞ ആ രഹസ്യം.",
  "start": 185.141,
  "end": 187.414
 },
 {
  "scene": "secret",
  "text": "ഒരു സ്ത്രീ ഒരു പുരുഷനെ ആഗ്രഹിക്കുന്നത്,",
  "start": 187.923,
  "end": 190.067
 },
 {
  "scene": "secret",
  "text": "അവൻ എങ്ങനെയുള്ളവനാണ് എന്നതുകൊണ്ട് മാത്രമല്ല.",
  "start": 190.343,
  "end": 193.111
 },
 {
  "scene": "secret",
  "text": "അവന്റെ കൂടെയിരിക്കുമ്പോൾ അവൾ സ്വയം എങ്ങനെ കാണുന്നു എന്നതുകൊണ്ടാണ്.",
  "start": 193.434,
  "end": 197.445
 },
 {
  "scene": "secret",
  "text": "നിന്റെ കൂടെയുള്ളപ്പോൾ അവൾക്ക് സുന്ദരിയായി തോന്നണം.",
  "start": 197.851,
  "end": 200.434
 },
 {
  "scene": "secret",
  "text": "ബുദ്ധിമതിയായി തോന്നണം.",
  "start": 200.807,
  "end": 201.849
 },
 {
  "scene": "secret",
  "text": "സുരക്ഷിതയായി തോന്നണം.",
  "start": 202.218,
  "end": 203.368
 },
 {
  "scene": "secret",
  "text": "ആ ഫീലിംഗ് അവൾക്ക് മറ്റാരിൽ നിന്നും കിട്ടില്ല.",
  "start": 203.755,
  "end": 206.149
 },
 {
  "scene": "after",
  "text": "അർജുൻ ഇത് മനസ്സിലാക്കി.",
  "start": 206.615,
  "end": 207.786
 },
 {
  "scene": "after",
  "text": "അവൻ ജിമ്മിൽ പോയി തുടങ്ങി.",
  "start": 208.103,
  "end": 209.206
 },
 {
  "scene": "after",
  "text": "സ്വന്തം ബിസിനസ് ഐഡിയയിൽ ജോലി ചെയ്തു.",
  "start": 209.487,
  "end": 211.358
 },
 {
  "scene": "after",
  "text": "ആളുകളെ ശരിക്കും കേൾക്കാൻ പഠിച്ചു.",
  "start": 211.681,
  "end": 213.506
 },
 {
  "scene": "after",
  "text": "ഒരു വർഷത്തിന് ശേഷം, അവൻ മറ്റൊരാളെ പരിചയപ്പെട്ടു.",
  "start": 213.865,
  "end": 216.73
 },
 {
  "scene": "after",
  "text": "ഇന്ന് അവൾ പറയുന്നത്,",
  "start": 217.144,
  "end": 218.138
 },
 {
  "scene": "after",
  "text": "\"അവന്റെ കൂടെയിരിക്കുമ്പോൾ എനിക്ക് ഞാനായിരിക്കാം.\"",
  "start": 218.394,
  "end": 220.757
 },
 {
  "scene": "outro",
  "text": "ഈ വീഡിയോ ഉപകാരപ്പെട്ടെങ്കിൽ, ഇത് ആവശ്യമുള്ള ഒരു സുഹൃത്തിന് അയച്ചുകൊടുക്കൂ.",
  "start": 221.248,
  "end": 224.985
 },
 {
  "scene": "outro",
  "text": "അടുത്ത വീഡിയോയിൽ, ഒരു സ്ത്രീ നിന്നിൽ താൽപ്പര്യമുണ്ടോ എന്ന് അറിയാനുള്ള ഏഴ് സൂചനകൾ പറയാം.",
  "start": 225.285,
  "end": 230.305
 },
 {
  "scene": "outro",
  "text": "അത് മിസ്സാകാതിരിക്കാൻ ഇപ്പോൾ തന്നെ സബ്സ്ക്രൈബ് ചെയ്യൂ.",
  "start": 230.626,
  "end": 233.185
 },
 {
  "scene": "outro",
  "text": "കാണാം.",
  "start": 233.456,
  "end": 233.716
 }
]