{
  "name": "video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "3D animated videos: Three.js (via @remotion/three + React Three Fiber) for animation, Remotion for captions and rendering",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Main out/video.mp4",
    "still": "remotion still Main out/thumbnail.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/zod-types": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "three": "0.187.0",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
