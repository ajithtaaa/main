[
 {
  "i": 0,
  "start": 0.0,
  "end": 4.028,
  "text": "In 2017, Elon Musk promised a car that could fly."
 },
 {
  "i": 1,
  "start": 4.518,
  "end": 5.548,
  "text": "Everyone laughed."
 },
 {
  "i": 2,
  "start": 5.969,
  "end": 6.868,
  "text": "Nine years later..."
 },
 {
  "i": 3,
  "start": 7.279,
  "end": 8.535,
  "text": "he actually did it."
 },
 {
  "i": 4,
  "start": 9.077,
  "end": 9.543,
  "text": "Kind of."
 },
 {
  "i": 5,
  "start": 10.05,
  "end": 14.834,
  "text": "It started because his friend Peter Thiel complained the future was supposed to have flying cars."
 },
 {
  "i": 6,
  "start": 15.231,
  "end": 16.663,
  "text": "So Elon basically said: fine."
 },
 {
  "i": 7,
  "start": 16.902,
  "end": 18.232,
  "text": "I'll make you one."
 },
 {
  "i": 8,
  "start": 18.777,
  "end": 22.493,
  "text": "Which is funny, because Elon used to say flying cars were terrifying..."
 },
 {
  "i": 9,
  "start": 22.817,
  "end": 25.973,
  "text": "because a loose hubcap could fall off and slice you in half."
 },
 {
  "i": 10,
  "start": 26.485,
  "end": 27.92,
  "text": "So how does it fly?"
 },
 {
  "i": 11,
  "start": 28.402,
  "end": 29.055,
  "text": "No wings."
 },
 {
  "i": 12,
  "start": 29.055,
  "end": 30.035,
  "text": "No propellers."
 },
 {
  "i": 13,
  "start": 30.32,
  "end": 33.35,
  "text": "Just ten nozzles blasting ultra high-pressure air..."
 },
 {
  "i": 14,
  "start": 33.691,
  "end": 35.636,
  "text": "like a rocket strapped to a sports car."
 },
 {
  "i": 15,
  "start": 36.223,
  "end": 40.943,
  "text": "On demo day, at a SpaceX rocket site in Texas, the car shot off a steel ramp..."
 },
 {
  "i": 16,
  "start": 41.264,
  "end": 43.331,
  "text": "did a full barrel roll in midair..."
 },
 {
  "i": 17,
  "start": 43.585,
  "end": 45.057,
  "text": "and landed on its wheels."
 },
 {
  "i": 18,
  "start": 45.439,
  "end": 47.254,
  "text": "Oh, and nobody was inside."
 },
 {
  "i": 19,
  "start": 47.728,
  "end": 49.995,
  "text": "Elon said that was so they didn't kill anyone."
 },
 {
  "i": 20,
  "start": 50.51,
  "end": 53.243,
  "text": "It goes zero to sixty in under one second."
 },
 {
  "i": 21,
  "start": 53.727,
  "end": 57.163,
  "text": "Elon admitted it's not exactly a safety-optimized car..."
 },
 {
  "i": 22,
  "start": 57.431,
  "end": 59.398,
  "text": "and might not even be legal everywhere."
 },
 {
  "i": 23,
  "start": 59.94,
  "end": 61.927,
  "text": "The crowd kept yelling, \"How much?\""
 },
 {
  "i": 24,
  "start": 62.37,
  "end": 63.213,
  "text": "Nobody answered."
 },
 {
  "i": 25,
  "start": 63.7,
  "end": 65.576,
  "text": "Production starts in 2028."
 },
 {
  "i": 26,
  "start": 65.923,
  "end": 67.536,
  "text": "So if you want a flying car..."
 },
 {
  "i": 27,
  "start": 67.779,
  "end": 68.807,
  "text": "start saving now."
 },
 {
  "i": 28,
  "start": 69.186,
  "end": 71.157,
  "text": "And maybe check your hubcaps."
 }
]