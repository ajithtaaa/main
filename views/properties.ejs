<%- include('partials/head') %>
<section class="wrap section">
  <h1 class="page-title">Rentals in <%= q.locality || 'Kochi' %> <small>below ₹10,000</small></h1>
  <%- include('partials/filters', { q }) %>
  <form class="toolbar" method="get" action="/properties">
    <% ['locality', 'type', 'max', 'q'].forEach(function (k) { if (q[k]) { %><input type="hidden" name="<%= k %>" value="<%= q[k] %>"><% } }) %>
    <span class="muted"><%= total %> propert<%= total === 1 ? 'y' : 'ies' %> found</span>
    <div class="toolbar-right">
      <select name="role" onchange="this.form.submit()">
        <option value="">Owner &amp; broker</option>
        <option value="Owner" <%= q.role === 'Owner' ? 'selected' : '' %>>Owners only</option>
        <option value="Broker" <%= q.role === 'Broker' ? 'selected' : '' %>>Brokers only</option>
      </select>
      <select name="tenant" onchange="this.form.submit()">
        <option value="">Any tenant</option>
        <% config.tenantPrefs.filter(function (t) { return t !== 'Any'; }).forEach(function (t) { %><option <%= q.tenant === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
      <select name="sort" onchange="this.form.submit()">
        <option value="new" <%= sort === 'new' ? 'selected' : '' %>>Newest</option>
        <option value="low" <%= sort === 'low' ? 'selected' : '' %>>Rent: low to high</option>
        <option value="high" <%= sort === 'high' ? 'selected' : '' %>>Rent: high to low</option>
        <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most viewed</option>
      </select>
    </div>
  </form>
  <% if (listings.length) { %>
    <div class="grid"><% listings.forEach(function (l) { %><%- include('partials/card', { l }) %><% }) %></div>
  <% } else { %>
    <div class="empty"><h3>No properties match your filters</h3><p class="muted">Try a different locality or a higher budget.</p><a class="btn" href="/properties">Clear filters</a></div>
  <% } %>
  <% if (pages > 1) { %>
    <nav class="pager">
      <% for (let i = 1; i <= pages; i++) { %><a class="<%= i === page ? 'active' : '' %>" href="/properties?<%= query ? query + '&' : '' %>page=<%= i %>"><%= i %></a><% } %>
    </nav>
  <% } %>
</section>
<%- include('partials/foot') %>
