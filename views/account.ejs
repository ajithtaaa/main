<%- include('partials/head') %>
<section class="wrap section">
  <h1 class="page-title">Hi, <%= user.name %></h1>
  <div class="account-grid">
    <div class="panel">
      <h3>Your account</h3>
      <p class="plan"><%= unlockedList.length %> contact<%= unlockedList.length === 1 ? '' : 's' %> unlocked</p>
      <% if (premium) { %><p class="plan premium">⭐ <%= user.role === 'admin' ? 'Admin – all contacts visible' : 'All-access (granted by admin)' %></p>
        <% if (user.role !== 'admin') { %><p class="muted small"><%= user.premium_until ? 'Valid till ' + date(user.premium_until) : 'Lifetime' %></p><% } %><% } %>
      <p class="muted">Each property’s contact costs ₹<%= settings.unlock_price %> to unlock and stays here forever.</p>
      <a class="btn" href="/properties">Browse properties</a>
      <hr>
      <p class="small"><strong>Email:</strong> <%= user.email %><br><strong>Mobile:</strong> <%= user.phone %><br><strong>Member since:</strong> <%= day(user.created_at) %></p>
    </div>
    <div class="panel">
      <h3>Payment requests</h3>
      <% if (!payments.length) { %><p class="muted">No payments yet.</p><% } else { %>
        <div class="table-wrap"><table>
          <thead><tr><th>Date</th><th>Property</th><th>UTR</th><th>Status</th></tr></thead>
          <tbody><% payments.forEach(function (p) { %>
            <tr><td class="small"><%= date(p.created_at) %></td><td><% if (p.listing_id) { %><a href="/property/<%= p.listing_id %>"><%= p.listing_title || "#" + p.listing_id %></a><% } else { %>–<% } %><div class="small muted"><%= inr(p.amount) %></div></td><td class="mono"><%= p.utr %></td>
              <td><%- include('partials/status', { s: p.status }) %><% if (p.status === 'rejected' && p.admin_note) { %><div class="small muted"><%= p.admin_note %></div><% } %></td></tr>
          <% }) %></tbody>
        </table></div>
      <% } %>
    </div>
  </div>

  <div class="panel">
    <h3>Your unlocked contacts</h3>
    <% if (!unlockedList.length) { %><p class="muted">Contacts you unlock will be saved here. Open any property and tap <em>Unlock for ₹<%= settings.unlock_price %></em>.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Property</th><th>Rent</th><th>Contact</th><th>Phone</th></tr></thead>
        <tbody><% unlockedList.forEach(function (v) { %>
          <tr><td><a href="/property/<%= v.id %>"><%= v.title %></a><div class="small muted"><%= v.locality %><%= v.status === 'rented' ? ' · rented out' : '' %></div></td><td><%= inr(v.rent) %></td>
            <td><%= v.contact_name %> <span class="role role-<%= v.contact_role.toLowerCase() %>"><%= v.contact_role %></span></td>
            <td><a class="strong" href="tel:<%= v.contact_phone %>"><%= v.contact_phone %></a></td></tr>
        <% }) %></tbody>
      </table></div>
    <% } %>
  </div>

  <details class="panel">
    <summary><strong>Change password</strong></summary>
    <form method="post" action="/account/password" class="form form-inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Current password<input type="password" name="current" required></label>
      <label>New password<input type="password" name="password" minlength="6" required></label>
      <button class="btn">Update</button>
    </form>
  </details>
</section>
<%- include('partials/foot') %>
