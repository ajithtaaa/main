<%- include('partials/head') %>
<section class="wrap auth">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="muted">Log in to unlock owner &amp; broker contacts.</p>
    <% if (typeof error !== 'undefined') { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="post" action="/login" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
      <label>Email<input type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"></label>
      <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
      <button class="btn btn-block">Log in</button>
    </form>
    <p class="center small">New here? <a href="/register?next=<%= encodeURIComponent(next) %>">Create a free account</a></p>
  </div>
</section>
<%- include('partials/foot') %>
