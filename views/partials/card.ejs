<a class="card" href="/property/<%= l.id %>">
  <div class="card-img">
    <img src="<%= img(l) %>" alt="<%= l.title %>" loading="lazy">
    <span class="price"><%= inr(l.rent) %><small>/mo</small></span>
    <% if (l.featured) { %><span class="tag tag-featured">★ Featured</span><% } %>
    <% if (l.status === 'rented') { %><span class="tag tag-rented">Rented out</span><% } %>
  </div>
  <div class="card-body">
    <h3><%= l.title %></h3>
    <p class="loc">📍 <%= l.locality %>, Kochi</p>
    <div class="chips">
      <span><%= l.type %></span><% if (l.bhk && l.bhk !== '-') { %><span><%= l.bhk %></span><% } %><span><%= l.furnishing %></span>
    </div>
    <div class="card-foot">
      <span class="role role-<%= l.contact_role.toLowerCase() %>"><%= l.contact_role %></span>
      <span class="lock"><%= (premium || unlocked.has(l.id)) ? "🔓 Unlocked" : "🔒 ₹" + settings.unlock_price + " to unlock" %></span>
    </div>
  </div>
</a>
