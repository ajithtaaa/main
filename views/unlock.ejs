<%- include('partials/head') %>
<section class="wrap section">
  <div class="paywall">
    <a href="/property/<%= listing.id %>" class="back">← Back to property</a>
    <a class="unlock-item" href="/property/<%= listing.id %>">
      <img src="<%= img(listing) %>" alt="">
      <div><strong><%= listing.title %></strong><div class="small muted">📍 <%= listing.locality %> · <%= listing.type %><%= listing.bhk && listing.bhk !== '-' ? ' · ' + listing.bhk : '' %> · <%= inr(listing.rent) %>/mo</div></div>
      <span class="role role-<%= listing.contact_role.toLowerCase() %>"><%= listing.contact_role %></span>
    </a>
    <% if (pending) { %>
      <div class="paywall-card center">
        <div class="big-icon">⏳</div>
        <h1>Payment under verification</h1>
        <p>We received your Transaction ID <strong class="mono"><%= pending.utr %></strong> on <%= date(pending.created_at) %>.</p>
        <p class="muted">Our team verifies every payment manually against our bank statement. This contact unlocks automatically once approved – usually within a few hours. Refresh this page to check.</p>
        <div class="row-center">
          <a class="btn" href="/properties">Keep browsing</a>
          <a class="btn btn-ghost" href="/account">Payment history</a>
        </div>
      </div>
    <% } else { %>
      <div class="paywall-card">
        <div class="paywall-head">
          <h1>Unlock this <%= listing.contact_role.toLowerCase() %>’s number</h1>
          <p class="muted">Pay <strong>₹<%= settings.unlock_price %></strong> to see the <%= listing.contact_role.toLowerCase() %>’s name and phone number for this property. It stays unlocked in your account – no expiry.</p>
        </div>
        <div class="notice">
          <strong>Please note:</strong> owners and brokers may sometimes be busy or unreachable, or the property may already be taken.
          Budget Brokers only shares the contact number; we are not responsible if they don’t answer or for any deal between you and them.
        </div>
        <% if (rejected) { %>
          <div class="alert alert-error">Your last payment (Transaction ID <span class="mono"><%= rejected.utr %></span>) could not be verified: <%= rejected.admin_note %>. Please check and submit the correct Transaction ID.</div>
        <% } %>
        <div class="pay-grid">
          <div class="pay-step">
            <span class="step-no">1</span>
            <h3>Scan &amp; pay ₹<%= settings.unlock_price %></h3>
            <div class="qr-box">
              <img src="<%= qr %>" alt="UPI payment QR code" width="240" height="240">
              <% if (settings.demo_mode === '1') { %><span class="qr-demo">DEMO QR</span><% } %>
            </div>
            <p class="upi">UPI ID: <strong class="mono" id="upi"><%= settings.upi_id %></strong> <button type="button" class="copy" data-copy="<%= settings.upi_id %>">Copy</button></p>
            <p class="small muted">Payee: <%= settings.payee_name %> · Amount: ₹<%= settings.unlock_price %></p>
            <a class="btn btn-block" href="/unlock/<%= listing.id %>/qr" download="budget-brokers-upi-qr.png">⬇ Download QR</a>
            <p class="small muted center" style="margin:-.3rem 0 .4rem">Paying from this phone? Download the QR, then open GPay / PhonePe → Scan → choose it from your gallery.</p>
            <a class="btn btn-ghost btn-block mobile-only" href="<%= link %>">Open UPI app to pay</a>
            <div class="apps">GPay · PhonePe · Paytm · BHIM · any UPI app</div>
          </div>
          <div class="pay-step">
            <span class="step-no">2</span>
            <h3>Enter your Transaction ID</h3>
            <p class="small">After paying, open the payment in your UPI app, copy the <strong>Transaction ID</strong> and paste it below.</p>
            <form method="post" action="/unlock/<%= listing.id %>" class="form" id="utr-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <label>Transaction ID
                <input name="utr" id="utr" maxlength="35" minlength="10" required placeholder="e.g. 412345678901" autocomplete="off" autocapitalize="characters" spellcheck="false" class="utr-input">
              </label>
              <p class="small muted" id="utr-help">Letters and numbers only · <span id="utr-count">0</span> characters</p>
              <label class="check"><input type="checkbox" required> I have paid ₹<%= settings.unlock_price %> to <%= settings.upi_id %> and read the note above</label>
              <button class="btn btn-block btn-lg">Submit for verification</button>
            </form>
            <details class="small">
              <summary>Where do I find the Transaction ID?</summary>
              <p><strong>GPay:</strong> tap the payment → UPI transaction ID.<br><strong>PhonePe:</strong> History → payment → Transaction ID.<br><strong>Paytm:</strong> Balance &amp; History → payment → UPI Ref No.</p>
            </details>
          </div>
        </div>
        <p class="small muted center">Payments are verified manually by our team. Each property needs its own payment and Transaction ID. Do not submit someone else’s Transaction ID – fake submissions lead to account block.</p>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/foot') %>
